{% extends 'base_template.html.twig' %}
    {% block content %}
        <h1>
            Bienvenue sur le super site de super Jobbuddy.
        </h1>
        <div id="zone_cartes" class="row row-cols-3">
            {% for annonce in annonces %}

                <!--Les cartes-->
                <div class="container">
                    <a href="index.php?controleur=annonce&methode=listerAnnonce&id_categorie={{categorie.id}}" class="col mb-3">
                        <div class="card mb-3">
                            <img src="..." class="card-img-top" alt="...">
                            <div class="card-body">
                                <h5 class="card-title">{{annonce.titre}}</h5>
                                <p class="card-text">{{annonce.typeService}}</p>
                                <p class="card-text"><small class="text-body-secondary">{{annonce.dateDebutRealisation}}</small></p>
                            </div>
                        </div>
                    </a>
                </div>

            {% endfor %}

        </div>
    {% endblock %}