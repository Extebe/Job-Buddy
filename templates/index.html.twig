    {% extends 'base_template.html.twig' %}

{% block title %}Accueil - JobBuddy{% endblock %}

{% block content %}
<div class="container">
    {# Hero Section avec meilleur guidage #}
    <div class="row align-items-center mb-5 mt-4">
        <div class="col-lg-8">            
            <h1 class="display-5 fw-bold mb-3">
                Trouvez le job étudiant idéal
            </h1>
            <p class="lead text-muted mb-4">
                <span class="badge badge-custom badge-primary">
                    <i class="bi bi-clock-history"></i>
                    {{ annonces|length }} annonce{{ annonces|length > 1 ? 's' : '' }} disponible{{ annonces|length > 1 ? 's' : '' }}
                </span>
            </p>
        </div>
    </div>
    
    {# Filtres et Recherche (Guidage amélioré) #}
    <form id="filterForm" method="POST" action="index.php?controleur=annonce&methode=rechercher">
    <div class="card-custom mb-4 p-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label">
                    <i class="bi bi-search me-1"></i>
                    Rechercher une annonce
                </label>
                <input type="text" id="recherche" name="recherche" class="form-control" placeholder="Titre, description..." value={{ recherche|default('') }}>
            </div>
            <div class="col-md-4">
                <label class="form-label">
                    <i class="bi bi-funnel me-1"></i>
                    Type de service
                </label>
                <select id="typeService" name="typeService" class="form-select">
                    <option value="" {% if typeService|default('') == '' %}selected{% endif %}>Tous les services</option>
                    <option value="Baby-sitting" {% if typeService|default('') == 'Baby-sitting' %}selected{% endif %}>Baby-sitting</option>
                    <option value="Jardinage" {% if typeService|default('') == 'Jardinage' %}selected{% endif %}>Jardinage</option>
                    <option value="Bricolage" {% if typeService|default('') == 'Bricolage' %}selected{% endif %}>Bricolage</option>
                    <option value="Ménage" {% if typeService|default('') == 'Ménage' %}selected{% endif %}>Ménage</option>
                    <option value="Transport" {% if typeService|default('') == 'Transport' %}selected{% endif %}>Transport</option>
                    <option value="Aide Informatique" {% if typeService|default('') == 'Aide Informatique' %}selected{% endif %}>Aide Informatique</option>
                    <option value="Aide Aux Devoirs" {% if typeService|default('') == 'Aide Aux Devoirs' %}selected{% endif %}>Aide Aux Devoirs</option>
                    <option value="Autre" {% if typeService|default('') == 'Autre' %}selected{% endif %}>Autre</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">
                    <i class="bi bi-sort-down me-1"></i>
                    Trier par
                </label>
                <select id="sortBy" name="sortBy" class="form-select">
                    <option value="date" {% if sortBy|default('date') == 'date' %}selected{% endif %}>Plus récentes</option>
                    <option value="remunerationAsc" {% if sortBy|default('date') == 'remunerationAsc' %}selected{% endif %}>Prix croissant</option>
                    <option value="remunerationDesc" {% if sortBy|default('date') == 'remunerationDesc' %}selected{% endif %}>Prix décroissant</option>
                </select>
            </div>
            <ul class="list-unstyled d-flex gap-2 mt-3"> 
                <li>
                    <button id="resetFilters" class="btn btn-outline-secondary mt-3" onclick="document.getElementById('recherche').value = ''; document.getElementById('typeService').value = ''; document.getElementById('sortBy').value = 'date';">
                        <i class="bi bi-x-circle me-1"></i>
                        Réinitialiser les filtres
                    </button>
                </li>
                <li>
                    <button id="submitFilters" class="btn btn-outline-primary mt-3" type="submit">
                        <i class="bi bi-search me-1"></i>
                        Rechercher
                    </button>
                </li> 
            </ul>
        </div>
    </div>
    </form>
    <div id="zone_cartes" class="row g-4">
    {% for annonce in annonces %}
    <div class="col-12 col-lg-6">
    <a href="index.php?controleur=annonce&methode=afficherDetail&id={{ annonce.id }}"> 
        <div class="card-custom h-100 annonce-card" data-type="{{ annonce.typeService }}" data-title="{{ annonce.titre|lower }}" data-description="{{ annonce.description|lower }}" data-price="{{ annonce.remuneration }}">
            <div class="card-body p-4">
                <div class="d-flex gap-3">
                    {# Icône du service #}
                    <div class="flex-shrink-0">
                        <div class="service-icon">
                            {% set iconMap = {
                                'Baby-sitting': 'bi-person-hearts',
                                'Jardinage': 'bi-tree',
                                'Bricolage': 'bi-hammer',
                                'Ménage': 'bi-house-heart',
                                'Transport': 'bi-car-front',
                                'Aide Informatique': 'bi-laptop',
                                'Aide Aux Devoirs': 'bi-book',
                                'Autre': 'bi-briefcase'
                            } %}
                            <i class="bi {{ iconMap[annonce.typeService] ?? 'bi-briefcase' }}"></i>
                        </div>
                    </div>
                    
                    {# Contenu #}
                    <div class="flex-grow-1 min-w-0">
                        {# En-tête #}
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="flex-grow-1 min-w-0">
                                <h5 class="card-title mb-1">
                                    
                                        {{ annonce.titre }}
                                    
                                </h5>
                                <span class="badge badge-custom badge-primary mb-2">
                                    {{ annonce.typeService }}
                                </span>
                            </div>
                        </div>
                        
                        {# Informations clés #}
                        <div class="d-flex flex-wrap gap-3 mb-3 text-muted small">
                            <span>
                                <i class="bi bi-geo-alt me-1"></i>
                                {{ annonce.lieu }}
                            </span>
                            <span>
                                <i class="bi bi-calendar-event me-1"></i>
                                {{ annonce.dateDebutRealisation|date("d/m/Y à H:i") }}
                            </span>
                        </div>
                        
                        {# Description #}
                        <p class="card-text text-muted mb-3">
                            {{ annonce.description|length > 120 ? annonce.description|slice(0, 120) ~ '...' : annonce.description }}
                        </p>
                        
                        {# Footer avec prix et action #}
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="price-tag">
                                <span class="h4 mb-0 text-primary fw-bold">{{ annonce.remuneration }} €</span>
                                <small class="text-muted d-block">Rémunération</small>
                            </div>
                            
                            {# Vérification si l'utilisateur a déjà postulé #}
                            {% set aDejaPostule = false %}
                            {% for candidat in annonce.postulations %}
                                {% if candidat.id == user.id %}
                                    {% set aDejaPostule = true %}
                                {% endif %}
                            {% endfor %}
                            
                            {# Affichage du bouton approprié #}
                            {% if user is defined and user.role == "particulier" %}
                                {% if annonce.etat == "disponible" and not aDejaPostule %}
                                    <div style="position: relative; z-index: 2;">
                                        <a href="index.php?controleur=annonce&methode=postulerAnnonce&id={{ annonce.id }}" class="btn btn-success">
                                            <i class="bi bi-hand-thumbs-up me-1"></i>
                                            Postuler
                                        </a>
                                    </div>
                                {% elseif aDejaPostule %}
                                    <div style="position: relative; z-index: 2;">
                                        <span class="badge badge-custom badge-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Candidature envoyée
                                        </span>
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </a>
    </div>
    {% endfor %}
</div>

<style>
/* Zone image : largeur fixe et petite */
.image-zone {
    width: 120px;        /* ↓ réduit fortement */
    min-width: 120px;
    max-width: 120px;
    height: 100%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;   /* empêche tout débordement */
}

/* Image elle-même */
.icon-annoncea {
    max-width: 70px;    /* ↓ image réellement petite */
    max-height: 70px;
    width: auto;
    height: auto;
    object-fit: contain;
}

/* Contenu : ne sort jamais de la carte */
.content-zone {
    flex: 1;
    min-width: 0;       /* IMPORTANT : empêche le texte de déborder */
}

.card-item {
    overflow: hidden;
}




.btn-outline-success {
    color: #712200;
    border-color: #712200;
}

.btn-outline-success:hover {
    color: #fbf2dd;
    background-color: #712200;
    border-color: #fbf2dd;
}

.btn-outline-success:focus {
    color: #fbf2dd;
    background-color: #712200;
    border-color: #fbf2dd;
}

.btn-outline-success::selection {
    color: #fbf2dd;
    background-color: #712200;
    border-color: #fbf2dd;
}

.btn-outline-success-danger {
    color: #ff0000;
    border-color: #ff0000;
}

.btn-outline-success-danger:hover {
    color: #fbf2dd;
    background-color: #ff0000;
    border-color: #fbf2dd;
}

.btn-outline-success-danger:focus {
    color: #fbf2dd;
    background-color: #ff0000;
    border-color: #fbf2dd;
}

.btn-outline-success-danger::selection {
    color: #fbf2dd;
    background-color: #ff0000;
    border-color: #fbf2dd;
}

.btn, .d-flex.gap-2 {
    position: relative;
    z-index: 1; /* pour être au-dessus du stretched-link */
}

</style>
    {% endblock %}




