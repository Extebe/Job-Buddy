{% extends 'base_template.html.twig' %}

{% block css %}
    <link rel="stylesheet" href="./stylePageDetails.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
{% endblock %}

{% block content %}
<div class="container py-5">

    {# --- Bouton Retour --- #}
    <div class="mb-4 text-start">
        <a href="{{ lienRetour }}" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour 
        </a>
    </div>

    <div class="row">
        {# ========================================== #}
        {# COLONNE GAUCHE : DÉTAILS DE L'ANNONCE      #}
        {# ========================================== #}
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body p-4 p-md-5">
                    
                    {# Badge des postulations #}
                    {% if user.role|lower != "particulier" or annonce.createur.id != user.id %}
                        <div class="text-end mb-3">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                                <i class="bi bi-clock-history me-1"></i>
                                {{ annonce.postulations|length }} étudiant{{ annonce.postulations|length > 1 ? 's' : '' }} ayant postulé{{ annonce.postulations|length > 1 ? 's' : '' }}
                            </span>
                        </div>
                    {% endif %}

                    <h3 class="card-title fw-bold text-dark mb-4">{{ annonce.titre }}</h3>

                    <div class="mb-4">
                        <h6 class="text-muted text-uppercase small fw-bold mb-2"><i class="bi bi-card-text me-2"></i>Description</h6>
                        <p class="text-dark">{{ annonce.description }}</p>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <h6 class="text-muted text-uppercase small fw-bold mb-1"><i class="bi bi-currency-euro me-2"></i>Rémunération</h6>
                                <p class="mb-0 fw-medium text-dark">{{ annonce.remuneration }} €</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <h6 class="text-muted text-uppercase small fw-bold mb-1"><i class="bi bi-geo-alt me-2"></i>Lieu</h6>
                                <p class="mb-0 fw-medium text-dark">{{ annonce.lieu }}</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <h6 class="text-muted text-uppercase small fw-bold mb-1"><i class="bi bi-calendar-event me-2"></i>Date de réalisation</h6>
                                <p class="mb-0 fw-medium text-dark">{{ annonce.dateDebutRealisation|date("d/m/Y à H:i") }}</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <h6 class="text-muted text-uppercase small fw-bold mb-1"><i class="bi bi-briefcase me-2"></i>Type de service</h6>
                                <p class="mb-0 fw-medium text-dark">{{ annonce.typeService }}</p>
                            </div>
                        </div>
                    </div>

                    {# Actions sur l'annonce (Postuler, Signaler, Modifier, Supprimer) #}
                    <div class="d-flex flex-wrap gap-2 mt-4 pt-4 border-top justify-content-end">
                        
                        {# Action Étudiant : Postuler #}
                        {% if user.role|lower == "etudiant" and annonce.etat|lower == "disponible" and not aPostule %}
                            <a href="index.php?controleur=annonce&methode=postulerAnnonce&id={{ annonce.id }}" class="btn btn-primary px-4">
                                <i class="bi bi-send me-2"></i>Postuler
                            </a>
                        {% endif %}

                        {% if user.role|lower == "etudiant" and annonce.etat|lower == "disponible" and aPostule %}
                            <a href="index.php?controleur=annonce&methode=depostulerAnnonce&id={{ annonce.id }}" class="btn btn-danger px-4">
                                <i class="bi bi-send me-2"></i>Annuler ma candidature
                            </a>
                        {% endif %}

                        {# Action : Signaler (Si ce n'est pas mon annonce) #}
                        {% if annonce.createur.id != user.id %}
                            <a href="index.php?controleur=signalement&methode=signalerAnnonce&idAnnonce={{ annonce.id }}" class="btn btn-outline-danger">
                                <i class="bi bi-flag me-1"></i> Signaler
                            </a>
                        {% endif %}

                        {# Actions Créateur : Modifier / Supprimer #}
                        {% if user.role|lower == "particulier" and annonce.createur.id == user.id %}
                            {% if annonce.etat|lower == "disponible" %}
                                <a href="index.php?controleur=annonce&methode=editerAnnonce&idAnnonce={{ annonce.id }}&idCreateur={{ annonce.createur.id }}" class="btn btn-outline-primary">
                                    <i class="bi bi-pencil me-1"></i> Modifier
                                </a>
                            {% endif %}
                            
                            <a href="index.php?controleur=annonce&methode=supprimerAnnonce&id={{ annonce.id }}" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette annonce ?');">
                                <i class="bi bi-trash me-1"></i> Supprimer
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# ========================================== #}
        {# COLONNE DROITE : PROFIL DU CRÉATEUR        #}
        {# ========================================== #}
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm border-0 text-center {#sticky-top#}fix-bottom" style="top: 20px;">
                <div class="card-body p-4 ">
                    <h6 class="text-muted text-uppercase small fw-bold mb-4">Annonce publiée par</h6>
                    
                    <div class="mb-3">
                        {% if createur.photoProfil is not empty %}
                            <img src="./uploads/profiles/{{ createur.photoProfil }}" alt="Photo de {{ annoncecreateur.prenom }}" 
                                 class="rounded-circle object-fit-cover shadow-sm border" 
                                 style="width: 120px; height: 120px;">
                        {% else %}
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto shadow-sm border" 
                                 style="width: 120px; height: 120px;">
                                <i class="bi bi-person text-secondary" style="font-size: 4rem;"></i>
                            </div>
                        {% endif %}
                    </div>

                    <h5 class="card-title fw-bold text-dark mb-1">{{ annonce.createur.prenom }} {{ annonce.createur.nom }}</h5>
                    
                    <a href="index.php?controleur=utilisateur&methode=pageUtilisateur&id={{ annonce.createur.id }}" class="btn btn-outline-primary w-100 mt-4">
                        <i class="bi bi-person-badge me-2"></i>Consulter son profil
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# ========================================== #}
    {# SECTION DU BAS : LISTE DES POSTULATIONS    #}
    {# ========================================== #}
    {% if user.role|lower == "particulier" and annonce.createur.id == user.id %}
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-people me-2 text-primary"></i>
                            {% if annonce.etat|lower == "disponible" %}
                                Étudiants ayant postulé
                            {% else %}
                                Étudiants acceptés
                            {% endif %}
                        </h5>
                    </div>
                    
                    <div class="card-body p-0">
                        {% if annonce.postulations|length > 0 %}
                            <ul class="list-group list-group-flush">
                                {% for etudiant in annonce.postulations %}
                                    <li class="list-group-item d-flex justify-content-between align-items-center p-4">
                                        <div class="d-flex align-items-center">
                                            {# Optionnel : Afficher la petite photo de l'étudiant s'il en a une #}
                                            {% if etudiant.photo is not empty %}
                                                <img src="./uploads/profiles/{{ etudiant.photoProfil }}" class="rounded-circle me-3 object-fit-cover" style="width: 40px; height: 40px;">
                                            {% else %}
                                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                    <i class="bi bi-person text-secondary"></i>
                                                </div>
                                            {% endif %}
                                            <span class="fw-medium">{{ etudiant.prenom }} {{ etudiant.nom }}</span>
                                        </div>

                                        {% if user.role|lower == "particulier" and annonce.etat|lower == "disponible" and annonce.createur.id == user.id %}
                                            <div class="btn-group shadow-sm" role="group">
                                                <a href="index.php?controleur=annonce&methode=selectionnerEtudiant&idAnnonce={{ annonce.id }}&idEtudiant={{ etudiant.id }}&action=accepter"
                                                   class="btn btn-success btn-sm px-3" title="Accepter">
                                                    <i class="bi bi-check-lg"></i>
                                                </a>
                                                <a href="index.php?controleur=annonce&methode=selectionnerEtudiant&idAnnonce={{ annonce.id }}&idEtudiant={{ etudiant.id }}&action=refuser"
                                                   class="btn btn-danger btn-sm px-3" title="Refuser">
                                                    <i class="bi bi-x-lg"></i>
                                                </a>
                                            </div>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <div class="p-5 text-center">
                                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                                <p class="text-muted mt-3 mb-0">Aucun étudiant n’a postulé pour cette annonce pour le moment.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

</div>
{% endblock %}