{% extends 'base_template.html.twig' %}
{% block title %} Page des Notes {% endblock %}

{% block content %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">


<link rel="stylesheet" href="CSS/styleHedaer.css">


  <div class="container my-5 py-5">
    <div class="row d-flex justify-content-center">
      <div class="col-md-12 col-lg-10 col-xl-8">
        <div class="card">
        <h1> Evaluation de {{ receveur.getNom() }} {{ receveur.getPrenom() }} </h1>
          <div class="card-body">
                <div class="star-rating">
      <input type="hidden" name="note" id="note" value="0">

      <i class="bi bi-star" data-value="1"></i>
      <i class="bi bi-star" data-value="2"></i>
      <i class="bi bi-star" data-value="3"></i>
      <i class="bi bi-star" data-value="4"></i>
      <i class="bi bi-star" data-value="5"></i>
    </div>

           


          </div>
          <div class="card-footer py-3 border-0" style="background-color: #f8f9fa;">
            <div class="d-flex flex-start w-100">
              
              <div data-mdb-input-init class="form-outline w-100">
                <textarea class="form-control" id="textAreaExample" rows="4"
                  style="background: #fff;"></textarea>
              </div>
            </div>
            <div class="float-end mt-2 pt-1">
              <button  type="button" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-sm">Envoyez</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>





<div class="container d-flex justify-content-center">
  <div class="text-center">


</div>



<style>
.star-rating i {
  font-size: 2rem;
  cursor: pointer;
  color: #dee2e6;
  transition: transform 0.2s;
}

.star-rating i.active {
  color: #ffca00;
}

.star-rating i:hover {
  transform: scale(1.2);
}
</style>

<script>
const stars = document.querySelectorAll('.star-rating i');
const input = document.getElementById('note');

let currentValue = 0;

stars.forEach(star => {
  star.addEventListener('click', () => {
    const clickedValue = Number(star.dataset.value);

    // 🔁 Si on reclique sur la même note → reset à 0
    if (clickedValue === currentValue) {
      currentValue = 0;
      input.value = 0;

      stars.forEach(s => {
        s.classList.remove('active', 'bi-star-fill');
        s.classList.add('bi-star');
      });
      return;
    }

    // ⭐ Sinon, on sélectionne normalement
    currentValue = clickedValue;
    input.value = clickedValue;

    stars.forEach(s => {
      const val = Number(s.dataset.value);
      s.classList.toggle('active', val <= clickedValue);
      s.classList.toggle('bi-star-fill', val <= clickedValue);
      s.classList.toggle('bi-star', val > clickedValue);
    });
  });
});
</script>




{% endblock %}