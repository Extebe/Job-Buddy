<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="CSS/styles.css">
    {# ---- PARTIE COOKIE ----   
     # commande à écrirer pour installer la bibliothèque : 
     #  npm i tarteaucitronjs 
     #}
    <script src="node_modules/tarteaucitronjs/tarteaucitron.min.js"></script>
        <script>
            (tarteaucitron.job = tarteaucitron.job || []).push('gcmanalyticsstorage');
        </script>
        <script type="text/javascript">
        tarteaucitron.init({
    	  "privacyUrl": "", /* Privacy policy url */
          "bodyPosition": "top", /* top to bring it as first element for accessibility */

    	  "hashtag": "#tarteaucitron", /* Open the panel with this hashtag */
    	  "cookieName": "tarteaucitron", /* Cookie name */
    
    	  "orientation": "middle", /* Banner position (top - bottom) */
       
          "groupServices": true, /* Group services by category */
          "showDetailsOnClick": true, /* Click to expand the description */
          "serviceDefaultState": "wait", /* Default state (true - wait - false) */
                           
    	  "showAlertSmall": false, /* Show the small banner on bottom right */
    	  "cookieslist": false, /* Show the cookie list in a mini banner */
          "cookieslistEmbed": false, /* Show the cookie list on the control panel */
                           
          "closePopup": true, /* Show a close X on the banner */

          "showIcon": true, /* Show cookie icon to manage cookies */
          //"iconSrc": "", /* Optionnal: URL or base64 encoded image */
          "iconPosition": "BottomRight", /* Position of the cookie (BottomRight - BottomLeft - TopRight - TopLeft) */

    	  "adblocker": false, /* Show a Warning if an adblocker is detected */
                           
          "DenyAllCta" : true, /* Show the deny all button */
          "AcceptAllCta" : true, /* Show the accept all button */
          "highPrivacy": true, /* HIGHLY RECOMMANDED Disable auto consent */
          "alwaysNeedConsent": false, /* Ask the consent for "Privacy by design" services */
                           
    	  "handleBrowserDNTRequest": false, /* If Do Not Track == 1, disallow all */

    	  "removeCredit": false, /* Remove credit link */
    	  "moreInfoLink": true, /* Show more info link */

          "useExternalCss": false, /* Expert mode: do not load the tarteaucitron.css file */
          "useExternalJs": false, /* Expert mode: do not load the tarteaucitron js files */

    	  //"cookieDomain": ".my-multisite-domaine.fr", /* Shared cookie for multisite */
                          
          "readmoreLink": "", /* Change the default readmore link */

          "mandatory": true, /* Show a message about mandatory cookies */
          "mandatoryCta": false, /* Show the disabled accept button when mandatory on */
    
          //"customCloserId": "", /* Optional a11y: Custom element ID used to open the panel */
          
          "googleConsentMode": true, /* Enable Google Consent Mode v2 for Google ads & GA4 */
          "bingConsentMode": true, /* Enable Bing Consent Mode for Clarity & Bing Ads */
          "pianoConsentMode": true, /* Enable Consent Mode for Piano Analytics */
          "pianoConsentModeEssential": false, /* Load in Essential mode instead of opt-out by default */
          "softConsentMode": false, /* Soft consent mode (consent is required to load the services) */

          "dataLayer": false, /* Send an event to dataLayer with the services status */
          "serverSide": false, /* Server side only, tags are not loaded client side */

          "partnersList": true /* Show the number of partners on the popup/middle banner */
        });
        </script>
        <script>
            tarteaucitron.user.gtagUa = 'G-QQF2T8V2DZ';
            // tarteaucitron.user.gtagCrossdomain = ['example.com', 'example2.com'];
            tarteaucitron.user.gtagMore = function () { /* add here your optionnal gtag() */ };
            (tarteaucitron.job = tarteaucitron.job || []).push('gtag');
        </script>
    {# ---- FIN PARTIE COOKIE ---- #}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Page du projet JobBuddy">
   
    <style>
        :root {
            {% if config.parameters.colors is defined %}
                --primary: {{ config.parameters.colors.primary }};
                --secondary: {{ config.parameters.colors.secondary }};
                --accent: {{ config.parameters.colors.accent }};
                --bg-color: {{ config.parameters.colors.bg_color }};
                --card-bg: {{ config.parameters.colors.card_bg }};
                --text-dark: {{ config.parameters.colors.text_dark }};
                --text-light: {{ config.parameters.colors.text_light }};
            {% endif %}
        }

        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }

        footer {
            margin-top: auto;
        }
    </style>

    {% block css %} {% endblock %}
    <title> {% block title %} Page d'accueil de JobBuddy {% endblock %} </title>
</head>


<body>
<header>
     <nav class="navbar navbar-expand-lg" style="background-color: #F7F5EF;">
        <div class="container-fluid">
            <a class="navbar-brand" href="index.php">
                <img src="./images/logo/logo_jobbuddy.png" alt="Logo" width="75" height="75" class="d-inline-block align-text-center ms-2">
                Jobbuddy
            </a>

            <ul class="navbar-nav mx-auto d-flex align-items-center">
                <form method='POST' action="index.php?controleur=annonce&methode=rechercher" id="filterForm">
                    <div class="d-flex align-items-center gap-2">
                        <li class="nav-item">
                            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
                                <span>Filtres</span>
                            </button>
                        </li>
                        <li class="nav-item d-flex align-items-center">
                            <input class="form-control form-control-lg" type="search" name="rechercheInput" id="searchInput" placeholder="Search" aria-label="Search" value="{{ recherche|default('') }}">
                        </li>
                        <li class="nav-item">
                            <button class="btn btn-outline-primary" type="submit">Appliquer</button>
                        </li>
                        <!-- Champ de recherche caché pour le formulaire -->
                        <input type="hidden" name="recherche" id="hiddenRecherche" value="{{ recherche|default('') }}">
                    </div>
                </form>
            </ul>

            {% if user.role == "particulier" %}
                <div class="btn-compte d-flex align-items-center">
                    <a href="index.php?controleur=annonce&methode=afficheFormAnnonce">
                        <button class="btn btn-outline-primary my-2 my-sm-0 me-2" type="submit">Poster Une Annonce</button>
                    </a>

                    <a href="index.php?controleur=annonce&methode=afficherMesAnnonces">
                        <button class="btn btn-outline-primary my-2 my-sm-0 me-2" type="submit">Mes Annonces</button>
                    </a>

                    <div class="dropdown">
                        <button class="btn btn-outline-primary my-2 my-sm-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="./images/icons/account-black.png" width="30" height="30">
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="index.php?controleur=utilisateur&methode=afficheCompte">Mon Compte</a></li>
                            <li><a class="dropdown-item" href="index.php?controleur=note&methode=afficher">Mes notes</a></li>
                            <li><a class="dropdown-item" href="index.php?controleur=utilisateur&methode=deconnexion">Se Déconnecter</a></li>
                        </ul>
                    </div>
                </div>

            {% elseif user.role == "etudiant" %}
                <div class="btn-compte d-flex align-items-center">
                    <a href="index.php?controleur=annonce&methode=afficherMesAnnonces">
                        <button class="btn btn-outline-primary my-2 my-sm-0 me-2" type="submit">Mes Annonces</button>
                    </a>

                    <div class="dropdown">
                        <button class="btn btn-outline-primary my-2 my-sm-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="./images/icons/account-black.png" width="30" height="30">
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="index.php?controleur=utilisateur&methode=afficheCompte">Mon Compte</a></li>
                            <li><a class="dropdown-item" href="index.php?controleur=note&methode=afficher">Mes notes</a></li>
                            <li><a class="dropdown-item" href="index.php?controleur=utilisateur&methode=deconnexion">Se Déconnecter</a></li>
                        </ul>
                    </div>
                </div>

            {% else %}
                <div class="btn-compte d-flex align-items-center">
                    <a href="index.php?controleur=utilisateur&methode=pageConnexion"><button class="btn btn-outline-primary my-2 my-sm-0 me-2" type="submit">se connecter</button></a>
                    <a href="index.php?controleur=utilisateur&methode=pageInscription"><button class="btn btn-outline-primary my-2 my-sm-0" type="submit">s'inscrire</button></a>
                </div>

            {% endif %}
            {% block headerListe %}
            {% endblock %}
        </div>
    </nav>
</header>

<!-- Menu des filtres (collapsible) -->
<div class="collapse" id="filterCollapse">
    <div style="background-color: #F7F5EF; border-bottom: 2px solid #dee2e6; padding: 20px 0;">
        <div class="container-fluid">
            <div class="row g-3">
                <div class="col-md-2">
                    <label for="typeService" class="form-label">Type de Service</label>
                    <select class="form-select" id="typeService" name="typeService" form="filterForm">
                        <option value="">-- Tous --</option>
                        <option value="baby-sitting" {% if typeService == 'baby-sitting' %}selected{% endif %}>Baby-sitting</option>
                        <option value="jardinage" {% if typeService == 'jardinage' %}selected{% endif %}>Jardinage</option>
                        <option value="bricolage" {% if typeService == 'bricolage' %}selected{% endif %}>Bricolage</option>
                        <option value="ménage" {% if typeService == 'ménage' %}selected{% endif %}>Ménage</option>
                        <option value="transport" {% if typeService == 'transport' %}selected{% endif %}>Transport</option>
                        <option value="aide informatique" {% if typeService == 'aide informatique' %}selected{% endif %}>Aide informatique</option>
                        <option value="aide aux devoirs" {% if typeService == 'aide aux devoirs' %}selected{% endif %}>Aide aux devoirs</option>
                        <option value="autre" {% if typeService == 'autre' %}selected{% endif %}>Autre</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="lieu" class="form-label">Lieu</label>
                    <input type="text" class="form-control" id="lieu" name="lieu" form="filterForm" placeholder="Ville ou code postal" value="{{ lieu|default('') }}">
                </div>

                <div class="col-md-2">
                    <label for="remunerationMin" class="form-label">Montant Min</label>
                    <input type="number" class="form-control" id="remunerationMin" name="remunerationMin" form="filterForm" placeholder="Min" step="0.01" value="{{ remunerationMin|default('') }}">
                </div>

                <div class="col-md-2">
                    <label for="remunerationMax" class="form-label">Montant Max</label>
                    <input type="number" class="form-control" id="remunerationMax" name="remunerationMax" form="filterForm" placeholder="Max" step="0.01" value="{{ remunerationMax|default('') }}">
                </div>

                <div class="col-md-2">
                    <label for="dateDebut" class="form-label">Date</label>
                    <input type="date" class="form-control" id="dateDebut" name="dateDebut" form="filterForm" value="{{ dateDebut|default('') }}">
                </div>

                <div class="col-md-2">
                    <label for="heureDebut" class="form-label">Heure</label>
                    <input type="time" class="form-control" id="heureDebut" name="heureDebut" form="filterForm" value="{{ heureDebut|default('') }}">
                </div>

                <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                    <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('typeService').value = ''; document.getElementById('lieu').value = ''; document.getElementById('remunerationMin').value = ''; document.getElementById('remunerationMax').value = ''; document.getElementById('dateDebut').value = ''; document.getElementById('heureDebut').value = '';">Réinitialiser les filtres</button>
                </div>
            </div>
        </div>
    </div>
</div>

<main>
{% block content %}
<link rel="stylesheet" href="CSS/styles.css">
{% endblock %}
</main>

<footer>
    <div class="container-fluid">
        <div class="row" style="min-height: 100px;">
            <div class="col-sm-3 d-flex justify-content-center align-items-center">
                <p class="mb-0">Jobbuddy</p>
            </div>

            <div class="col-sm-3 d-flex justify-content-center align-items-center">
                <a class="mb-0" href='index.php?controleur=newsLetter&methode=afficher'>S'inscrire à la news letter</a>
            </div>

            <div class="col-sm-3 d-flex justify-content-center align-items-center">
                <a class="mb-0" href='index.php?controleur=annonce&methode=afficherStatistiques'>Statistiques</a>
            </div>

            <div class="col-sm-3 d-flex justify-content-center align-items-center">
                <p class="mb-0">Nous contacter</p>
            </div>
        </div>
        <div class="row" style="min-height: 50px;">
            <div class="col-sm-12 d-flex justify-content-center align-items-center">
                <p class="mb-0">Copyrights</p>
            </div>
        </div>
    </div>
</footer>
{% block script %}
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <script>
        // Synchronisation entre la barre de recherche et le champ caché du formulaire
        const searchInput = document.getElementById('searchInput');
        const hiddenRecherche = document.getElementById('hiddenRecherche');

        searchInput.addEventListener('input', function() {
            hiddenRecherche.value = this.value;
        });

        // Ouvrir automatiquement le formulaire de filtres s'il y a des filtres actifs
        window.addEventListener('load', function() {
            const hasFilters =
                document.getElementById('typeService').value ||
                document.getElementById('lieu').value ||
                document.getElementById('remunerationMin').value ||
                document.getElementById('remunerationMax').value ||
                document.getElementById('dateDebut').value ||
                document.getElementById('heureDebut').value;

            if (hasFilters) {
                const filterCollapse = new bootstrap.Collapse(document.getElementById('filterCollapse'), {
                    toggle: true
                });
            }
        });
    </script>
{% endblock %}
</body>
</html>
