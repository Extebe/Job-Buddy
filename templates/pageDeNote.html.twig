
{% extends 'base_template.html.twig' %}
{% block title %} Page des Notes {% endblock %}

{% block content %}
<link rel="stylesheet" href="CSS/styleHedaer.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<h1 class=" ms-2 mt-2 mb-4">Mes Notes</h1>


{%for note in notes %}

<div class="card  mt-3 ms-5 me-5">
  <div class="card-header">
    {{ note.annonce.getTitre() }} - {{ note.auteur.getNom() }} {{ note.auteur.getPrenom() }} 
    <div class="stars"> {% for i in 1..5 %} <i class="bi {{ i <= note.valeur ? 'bi-star-fill' : 'bi-star' }}"></i> {% endfor %} </div>

    <h4>{{ note.auteur.getNom() }}</h4>
  </div>
  <div class="card-body">
    <figure>
      <blockquote class="blockquote">
        <p>{{ note.commentaire }}</p>
      </blockquote>
    </figure>
  </div>
</div>
{% endfor %}
{% endblock %}