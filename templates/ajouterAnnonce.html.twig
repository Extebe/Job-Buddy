{% extends 'base_template.html.twig' %}
    {% block content %}
        <div class="container form-narrow">
            <h1>Ajout d'une annonce</h1>
            {% if msg_erreur %}
                <p style="color:red;">{{ msg_erreur }}</p>
            {% endif %}

            <form action="index.php?controleur=annonce&methode=traiteFormAnnonce" method="post">
                <div class="mb-3">
                    <label for="" class="form-label">Titre de l'annonce</label>
                    <input type="text" class="form-control" id="titreAnnonce" name="titreAnnonce" value="{{ dataForm.titre ?? '' }}" required>
                </div>

                <div class="mb-3">
                    <label for="select" class="form-label">Type de service</label>
                    <select name="typeService" id="typeService" class="form-control" required>
                        <option value="" selected disabled>-- Choisissez une option --</option>
                        <option>Baby-sitting</option>
                        <option>Jardinage</option>
                        <option>Bricolage</option>
                        <option>Ménage</option>
                        <option>Transport</option>
                        <option>Aide Informatique</option>
                        <option>Aide Aux Devoirs</option>
                        <option>Autre</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="text" class="form-label">Lieu</label>
                    <input type="text" class="form-control" id="lieu" name="lieu"value="{{ dataForm.lieu ?? '' }}" required >
                </div>

                <div class="mb-3">
                    <label for="text" class="form-label">Prix</label>
                    <input type="number" class="form-control" id="prix" name="prix" min="0" max="999" value="{{ dataForm.prix ?? '' }}"required >
                </div>

                <div class="mb-3">
                    <label class="form-label">Date début réalisation</label>
                    <input
                            type="datetime-local"
                            class="form-control"
                            id="dateDebut"
                            name="dateDebut"
                            required
                            min="<?= date('Y-m-d\TH:i') ?>"
                            value="{{ dataForm.dateDebut ?? '' }}"
                    >
                </div>

                <div class="mb-3">
                    <label class="form-label">Date fin de réalisation</label>
                    <input
                            type="datetime-local"
                            class="form-control"
                            id="dateFin"
                            name="dateFin"
                            required
                            min="<?= date('Y-m-d\TH:i') ?>"
                            value="{{ dataForm.dateFin ?? '' }}"
                    >
                </div>

                <div class="mb-3">
                    <label for="" class="form-label">Description</label>
                    <textarea type="text" class="form-control" id="description" name="description" value="{{ dataForm.description ?? '' }}"required></textarea>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-outline-success my-2 my-sm-0">Publier l'annonce</button>
                </div>
            </form>
        </div>
    {% endblock %}