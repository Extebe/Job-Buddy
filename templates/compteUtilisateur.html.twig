{% extends 'base_template.html.twig' %}

{% block css %} 
    <link rel="stylesheet" href="./CSS/compte.css"> 
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
{% endblock %}

{% block content %}
{% if other.nom != "" %}

<div class="container py-5">
    {# --- Bouton Retour --- #}
    <div class="mb-4 text-start">
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour 
        </a>
    </div>
    <div class="row">
        
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm text-center h-100">
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    
                    {% if other.photoProfil is not empty %}
                        <img src="./uploads/profiles/{{ other.photoProfil }}" alt="Photo de profil" 
                             class="rounded-circle img-fluid mb-3 shadow-sm border" 
                             style="width: 150px; height: 150px; object-fit: cover;">
                    {% else %}
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mb-3 shadow-sm border" 
                             style="width: 150px; height: 150px;">
                            <i class="bi bi-person text-secondary" style="font-size: 4rem;"></i>
                        </div>
                    {% endif %}
                    
                    <h4 class="mb-1">{{ other.prenom }} {{ other.nom }}</h4>
                    <p class="text-muted mb-0">{{ other.role|capitalize }}</p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <h5 class="card-title border-bottom pb-3 mb-4">Informations de l'utilisateur</h5>
                    
                    <div class="row mb-3">
                        <div class="col-sm-4"><h6 class="mb-0 text-muted"><i class="bi bi-telephone me-2"></i>Téléphone</h6></div>
                        <div class="col-sm-8 text-dark fw-medium">{{ other.tel }}</div>
                    </div>
                    <hr class="text-muted opacity-25">
                    
                    <div class="row mb-3">
                        <div class="col-sm-4"><h6 class="mb-0 text-muted"><i class="bi bi-geo-alt me-2"></i>Ville</h6></div>
                        <div class="col-sm-8 text-dark fw-medium">{{ other.ville }}</div>
                    </div>
                    <hr class="text-muted opacity-25">
                    
                    <div class="row mb-3">
                        <div class="col-sm-4"><h6 class="mb-0 text-muted"><i class="bi bi-mailbox me-2"></i>Code postal</h6></div>
                        <div class="col-sm-8 text-dark fw-medium">{{ other.codePostal }}</div>
                    </div>
                    <hr class="text-muted opacity-25">
<div class="row mb-3 align-items-center ">
    <div class="col-sm-4">
        <h6 class="mb-0 text-muted">Évaluation</h6>
    </div>
    <div class="col-sm-8 d-flex align-items-center">
        {# Remplace "user.noteMoyenne" par le nom exact de ta variable dans ton modèle #}
        {% set note = moyenne|default(0) %}
        
        {% if note > 0 %}
            <div class="d-flex text-warning fs-5 me-2">
                {% for i in 1..5 %}
                    {% if note >= i %}
                        {# Étoile pleine #}
                        <i class="bi bi-star-fill"></i>
                    {% elseif note >= (i - 0.5) %}
                        {# Demi-étoile #}
                        <i class="bi bi-star-half"></i>
                    {% else %}
                        {# Étoile vide #}
                        <i class="bi bi-star text-secondary" style="opacity: 0.3;"></i>
                    {% endif %}
                {% endfor %}
            </div>
            <span class="text-muted fw-medium">{{ note|number_format(1, ',', ' ') }} / 5</span>
            {% else %}
                <span class="text-muted fst-italic small">
                    Pas encore d'avis pour le moment
                </span>
            {% endif %}
    </div>

                    <div class="mt-5 pt-4 border-top text-end">
                        {% if other.id != user.id %}
                            <a href="index.php?controleur=signalement&methode=signalerUtilisateur&idOther={{ other.id }}" 
                               class="btn btn-outline-danger">
                                <i class="bi bi-flag-fill me-2"></i>Signaler cet utilisateur
                            </a>
                        {% endif %}
                    </div>
                    
                </div>
            </div>
        </div>
        
    </div>
</div>
{% else %}
    <script>window.location.href = 'index.php';</script>
{% endif %}
{% endblock %}