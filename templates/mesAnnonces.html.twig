{% extends 'base_template.html.twig' %}

{% block content %}

    {# ================= MENU ONGLET ================= #}
    {% set filtreActif = filtre ?? '' %}

    <ul class="nav nav-tabs mb-4 justify-content-center">
        <li class="nav-item">
            <a class="nav-link {{ filtreActif == 'all' ? 'active' : '' }}"
               href="index.php?controleur=annonce&methode=afficherMesAnnonces&filtre=all">
                Toutes
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ filtreActif == 'disponible' ? 'active' : '' }}"
               href="index.php?controleur=annonce&methode=afficherMesAnnonces&filtre=disponible">
                Disponibles
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ filtreActif == 'accepte' ? 'active' : '' }}"
               href="index.php?controleur=annonce&methode=afficherMesAnnonces&filtre=accepte">
                Acceptées
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ filtreActif == 'confirme' ? 'active' : '' }}"
               href="index.php?controleur=annonce&methode=afficherMesAnnonces&filtre=confirme">
                Confirmées
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ filtreActif == 'termine' ? 'active' : '' }}"
               href="index.php?controleur=annonce&methode=afficherMesAnnonces&filtre=termine">
                Terminées
            </a>
        </li>
    </ul>

    <div class="container">
        <div id="zone_cartes" class="row g-4">

            {# ============ AJOUT ANNONCE ============ #}
            {% if user.role == "particulier" %}
                <div class="col-12 col-lg-6">
                    <a href="index.php?controleur=annonce&methode=afficheFormAnnonce" class="text-decoration-none">
                        <div class="card-custom h-100 add-card-style d-flex align-items-center justify-content-center" style="min-height: 160px;">
                            <span style="font-size: 2rem; font-weight: 700; color: #712200; margin-right: 10px;">+</span>
                            <span style="font-size: 1.4rem; font-weight: 600; color: #591B00;">Publier une annonce</span>
                        </div>
                    </a>
                </div>
            {% endif %}

            {# ============ TOAST MESSAGES ============ #}
            <div class="toast-container position-fixed bottom-0 end-0 p-3">
                {% if msg %}
                    <div id="myToast" class="toast align-items-center text-white bg-success border-0" role="alert">
                        <div class="d-flex">
                            <div class="toast-body">{{ msg }}</div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>
                {% endif %}
            </div>

            {# ============ CARTES ANNONCES ============ #}
            {% for annonce in annonces %}
                <div class="col-12 col-lg-6">
                    <div class="card-custom h-100 annonce-card position-relative">
                        <div class="card-body p-4">
                            <div class="d-flex gap-3">
                                {# Icône du service #}
                                <div class="flex-shrink-0">
                                    <div class="service-icon">
                                        {% set iconMap = {
                                            'baby-sitting': 'bi-person-hearts',
                                            'jardinage': 'bi-tree',
                                            'bricolage': 'bi-hammer',
                                            'menage': 'bi-house-heart',
                                            'transport': 'bi-car-front',
                                            'aide informatique': 'bi-laptop',
                                            'aide aux devoirs': 'bi-book',
                                            'autre': 'bi-briefcase'
                                        } %}
                                        <i class="bi {{ iconMap[annonce.typeService] ?? 'bi-briefcase' }} fs-2"></i>
                                    </div>
                                </div>

                                {# Contenu #}
                                <div class="flex-grow-1 min-w-0">
                                    {# En-tête avec TITRE et ÉTAT #}
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="w-100">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h5 class="card-title mb-0 text-truncate">
                                                    <a href="index.php?controleur=annonce&methode=afficherDetail&id={{ annonce.id }}" class="text-decoration-none text-dark">
                                                        {{ annonce.titre }}
                                                    </a>
                                                </h5>

                                                {# --- LOGIQUE D'AFFICHAGE DE L'ÉTAT --- #}
                                                {% set statusStyles = {
                                                    'disponible': 'bg-info',
                                                    'accepte':    'bg-warning text-dark',
                                                    'confirme':   'bg-primary',
                                                    'termine':    'bg-success'
                                                } %}
                                                <span class="badge {{ statusStyles[annonce.etat] ?? 'bg-secondary' }} ms-2 text-uppercase" style="font-size: 0.7rem;">
                                                {{ annonce.etat }}
                                            </span>
                                            </div>
                                            <span class="badge badge-custom badge-primary mt-2">
                                            {{ annonce.typeService }}
                                        </span>
                                        </div>
                                    </div>

                                    {# Informations clés #}
                                    <div class="d-flex flex-wrap gap-3 mb-3 text-muted small">
                                        <span><i class="bi bi-geo-alt me-1"></i>{{ annonce.lieu }}</span>
                                        <span><i class="bi bi-calendar-event me-1"></i>{{ annonce.dateDebutRealisation|date("d/m/Y à H:i") }}</span>
                                    </div>

                                    {# Description #}
                                    <p class="card-text text-muted mb-3">
                                        {{ annonce.description|length > 120 ? annonce.description|slice(0, 120) ~ '...' : annonce.description }}
                                    </p>

                                    {# Footer avec prix et action #}
                                    <div class="d-flex justify-content-between align-items-center mt-auto">
                                        <div class="price-tag">
                                            <span class="h4 mb-0 text-primary fw-bold">{{ annonce.remuneration }} €</span>
                                        </div>
                                        <div class="d-flex gap-2 flex-wrap justify-content-end">
                                            {% if annonce.etat == "confirme" and annonce.dateFinRealisation < "now"|date("Y-m-d") %}
                                                <a href="index.php?controleur=note&methode=saisieNote&id={{ annonce.id }}" class="btn btn-outline-success btn-sm rounded-pill">Évaluer</a>
                                            {% endif %}

                                            {% if user.getRole() == "particulier" and annonce.getEtat() == "disponible" and annonce.getCreateur().getId() == user.getId() %}
                                                <a href="index.php?controleur=annonce&methode=editerAnnonce&id={{ annonce.id }}" class="btn btn-outline-primary btn-sm rounded-pill">Modifier</a>
                                            {% endif %}

                                            {% if user.getRole() == "particulier" and annonce.getCreateur().getId() == user.getId() %}
                                                <a href="index.php?controleur=annonce&methode=supprimerAnnonce&id={{ annonce.id }}" class="btn btn-outline-danger btn-sm rounded-pill" onclick="return confirm('Êtes-vous sûr ?')">Supprimer</a>
                                            {% endif %}

                                            {% if user.getRole() == "etudiant" and annonce.getEtat() == "accepte" %}
                                                <a href="index.php?controleur=annonce&methode=confirmePostulation&idEtudiant={{ user.getId() }}&idAnnonce={{ annonce.id }}&action=confirme" class="btn btn-outline-primary btn-sm rounded-pill" onclick="return confirm('Confirmer votre présence ?')">Confirmer ma présence</a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>


{% endblock %}