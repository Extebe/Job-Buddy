{% extends 'base_template.html.twig' %}

{% block content %}

{# ================= MENU ONGLET ================= #}
{% set filtreActif = filtre ?? '' %}

<ul class="nav nav-tabs mb-4 justify-content-center">
    <li class="nav-item">
        <a class="nav-link {{ filtreActif == 'all' ? 'active' : '' }}"
           href="index.php?controleur=annonce&methode=afficherMesAnnonces&filtre=all">
            Toutessqqssq
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link {{ filtreActif == 'disponible' ? 'active' : '' }}"
           href="index.php?controleur=annonce&methode=afficherMesAnnonces&filtre=disponible">
            Disponibles
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link {{ filtreActif == 'accepte' ? 'active' : '' }}"
           href="index.php?controleur=annonce&methode=afficherMesAnnonces&filtre=accepte">
            Acceptées
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link {{ filtreActif == 'termine' ? 'active' : '' }}"
           href="index.php?controleur=annonce&methode=afficherMesAnnonces&filtre=termine">
            Terminées
        </a>
    </li>
</ul>

<div class="container">
    <div id="zone_cartes" class="row g-4">

        {# ============ AJOUT ANNONCE ============ #}
        {% if user.role == "particulier" %}
            <div class="col-12 col-lg-6">
                <a href="index.php?controleur=annonce&methode=afficheFormAnnonce">
                    <div class="card-custom h-100 add-card-style" style="display: flex; align-items: center; justify-content: center; min-height: 160px;">
                        <span style="font-size: 2rem; font-weight: 700; color: #712200; margin-right: 10px;">+</span>
                        <span style="font-size: 1.4rem; font-weight: 600; color: #591B00;">Publier une annonce</span>
                    </div>
                </a>
            </div>
        {% endif %}
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
        
        {% if msg %}
            <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050;">
            {# On définit la couleur selon le type via un petit switch logique #}
            {% set bgColor = 'bg-success' %}
                <div id="myToast" class="toast align-items-center text-white {{ bgColor }} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            {{ msg }}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            </div>
        <script src="JS/toast.javascript.js"></script>
        {% endif %}
    </div>

        {# ============ CARTES ANNONCES ============ #}
        {% for annonce in annonces %}
            <div class="col-12 col-lg-6">
                <a href="index.php?controleur=annonce&methode=afficherDetail&id={{ annonce.id }}">
                    <div class="card-custom h-100 annonce-card" data-type="{{ annonce.typeService }}" data-title="{{ annonce.titre|lower }}" data-description="{{ annonce.description|lower }}" data-price="{{ annonce.remuneration }}">
                        <div class="card-body p-4">
                            <div class="d-flex gap-3">
                                {# Icône du service #}
                                <div class="flex-shrink-0">
                                    <div class="service-icon">
                                        {% set iconMap = {
                                            'baby-sitting': 'bi-person-hearts',
                                            'jardinage': 'bi-tree',
                                            'bricolage': 'bi-hammer',
                                            'menage': 'bi-house-heart',
                                            'transport': 'bi-car-front',
                                            'aide informatique': 'bi-laptop',
                                            'aide aux devoirs': 'bi-book',
                                            'autre': 'bi-briefcase'
                                        } %}

                                        <i class="bi {{ iconMap[annonce.typeService] ?? 'bi-briefcase' }} fs-2"></i>
                                    </div>
                                </div>

                                {# Contenu #}
                                <div class="flex-grow-1 min-w-0">
                                    {# En-tête #}
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="flex-grow-1 min-w-0">
                                            <h5 class="card-title mb-1">

                                                {{ annonce.titre }}

                                            </h5>
                                            <span class="badge badge-custom badge-primary mb-2">
                                    {{ annonce.typeService }}
                                </span>
                                        </div>
                                    </div>

                                    {# Informations clés #}
                                    <div class="d-flex flex-wrap gap-3 mb-3 text-muted small">
                            <span>
                                <i class="bi bi-geo-alt me-1"></i>
                                {{ annonce.lieu }}
                            </span>
                                        <span>
                                <i class="bi bi-calendar-event me-1"></i>
                                {{ annonce.dateDebutRealisation|date("d/m/Y à H:i") }}
                            </span>
                                    </div>

                                    {# Description #}
                                    <p class="card-text text-muted mb-3">
                                        {{ annonce.description|length > 120 ? annonce.description|slice(0, 120) ~ '...' : annonce.description }}
                                    </p>

                                    {# Footer avec prix et action #}
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="price-tag">
                                            <span class="h4 mb-0 text-primary fw-bold">{{ annonce.remuneration }} €</span>
                                        </div>
                                        <div class="d-flex gap-2 align-items-center">
                                            {% if annonce.etat == "accepte" and annonce.dateFinRealisation < "now"|date("Y-m-d") %}
                                                <a href="index.php?controleur=note&methode=saisieNote&id={{ annonce.id }}"
                                                   class="btn btn-outline-success btn-sm">
                                                    Évaluer
                                                </a>
                                            {% endif %}

                                            {% if user.getRole() == "particulier" and annonce.getEtat() == "disponible"
                                                and annonce.getCreateur().getId() == user.getId() %}
                                                <a href="index.php?controleur=annonce&methode=editerAnnonce&id={{ annonce.id }}"
                                                   class="btn btn-outline-success btn-sm">
                                                    Modifier
                                                </a>
                                            {% endif %}

                                            {% if user.getRole() == "particulier"
                                                and annonce.getCreateur().getId() == user.getId() %}
                                                <a href="index.php?controleur=annonce&methode=supprimerAnnonce&id={{ annonce.id }}"
                                                   class="btn btn-outline-danger btn-sm"
                                                   data-confirm="Êtes-vous sûr de vouloir supprimer cette annonce ?">
                                                    Supprimer
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>
</div>


<style>
/* Ajustements spécifiques pour la zone d'action */
.btn-group-ads {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}
</style>
{% endblock %}